{
  "name": "nexusbrain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "doctor": "tsx --env-file-if-exists=.env.local scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "REQUIRE_DB=1 vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "falkordb": "^6.8.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "^1.29.2",
    "unpdf": "^1.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
