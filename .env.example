# ---------------------------------------------------------------
# NexusBrain environment. Copy to .env.local (never commit it).
# All values are read on the server only; nothing here reaches the browser.
# ---------------------------------------------------------------

# FalkorDB connection: falkor://[user:password@]host:port  (use falkors:// for TLS)
# Default matches `npm run db:up` (docker-compose.yml).
FALKORDB_URL=falkor://localhost:6379

# Graph (key) name inside FalkorDB. Tests use their own graph, "nexusbrain_test".
FALKORDB_GRAPH=nexusbrain

# OPTIONAL. Enables LLM answer synthesis in chat AND LLM entity extraction during ingestion.
# Leave empty to run fully offline: chat returns retrieved, verified facts and ingestion
# uses the deterministic rule-based extractor.
ANTHROPIC_API_KEY=

# Model used when ANTHROPIC_API_KEY is set. Confirm the id is available to your account.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Hosting / demo options (all optional) ----
# Require HTTP Basic auth (any username, this value as the password) for the whole app except /api/health.
NEXUS_ACCESS_TOKEN=
# Show a "Reset demo data" button and enable POST /api/demo/reset. Leave false on anything with real data.
ENABLE_DEMO_RESET=false
# Only set to true behind a trusted reverse proxy; otherwise X-Forwarded-For is ignored for rate limiting.
TRUST_PROXY=false
